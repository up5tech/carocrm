{
  "entities": {
    "Project": {
      "fields": {
        "budget": {
          "type": "currency",
          "inDetail": true,
          "inEdit": true,
          "label": "Budget"
        },
        "progress": {
          "type": "int",
          "defaultValue": 0,
          "inList": true,
          "inDetail": true,
          "inEdit": true,
          "label": "Progress"
        },
        "isOverdue": {
          "type": "formula",
          "formula": "isNotEmpty(field(\"dateEnd\")) && field(\"dateEnd\") < now()",
          "inList": true,
          "inDetail": true,
          "label": "Overdue"
        }
      },
      "indexes": [{ "name": "idx_project_progress", "fields": ["progress"] }]
    }
  }
}
