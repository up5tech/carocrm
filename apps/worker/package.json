{
  "name": "@carocrm/worker",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "enqueue": "tsx src/tools/enqueue-cli.ts",
    "test:smoke": "bash ../../scripts/worker-smoke.sh"
  },
  "dependencies": {
    "@carocrm/core": "workspace:*",
    "@carocrm/metadata": "workspace:*",
    "@carocrm/entity-engine": "workspace:*",
    "@carocrm/jobs": "workspace:*",
    "bullmq": "^5.0.0",
    "cron-parser": "^4.9.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "zod": "^3.24.0",
    "@carocrm/files": "workspace:*",
    "@carocrm/mail": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
