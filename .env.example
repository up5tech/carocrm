DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/carocrm_dev
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
REDIS_URL=redis://127.0.0.1:6379
APP_PORT=3030
APP_HOST=127.0.0.1
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
STORAGE_ROOT=.data/files
# Attachments / file storage (PLAN §25). local = disk under STORAGE_ROOT; s3/minio need S3_BUCKET.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
# MinIO/S3-compatible endpoint, e.g. http://127.0.0.1:9000 (empty = AWS default endpoint).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Empty = derive (MinIO uses path style); set true/false to override.
S3_FORCE_PATH_STYLE=
# Upload ceilings in MB, enforced while streaming.
UPLOAD_MAX_MB=25
UPLOAD_CHUNK_MAX_MB=8
# Pre-signed download URL lifetime (object storage only).
SIGNED_URL_TTL_SECONDS=900
# signature = built-in scanner (EICAR + magic/MIME mismatch), none = disabled.
MALWARE_SCAN_MODE=signature
# Grace hours after a chunked upload's deadline before system.cleanupUploads removes its parts.
WORKER_UPLOAD_EXPIRY_HOURS=24
LOG_LEVEL=info
# Comma-separated list of origins allowed to make credentialed cross-origin requests.
# Empty (default) disables CORS entirely (fail-closed). Example: http://localhost:5173,https://crm.example.com
CORS_ORIGINS=
RATE_LIMIT_MAX=300
# Phase 23.2 (PLAN §8 task 1) — per-source ceiling on authentication attempts (login, 2FA challenge,
# refresh) per window, and the trailing window inside which failed sign-ins are counted for the
# per-account lockout. Default 20 attempts / 900 seconds (15 min) per client IP.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Phase 23.2 (PLAN §8 task 1) — per-account failed-login lockout: after this many failures within the
# window the account is locked for this long. Default: 5 failures / 30 minutes.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_SECONDS=1800
# Phase 23.2 (PLAN §8 task 2) — self-service password-reset token lifetime (seconds, default 1 hour).
# Reset mail needs a configured transport (MAIL_TRANSPORT=smtp/relay) and SMTP_FROM; with the default
# `none` transport reset requests answer generically but no token is minted.
PASSWORD_RESET_TTL_SECONDS=3600
# Per-request and per-query deadlines (G74). 0 disables a ceiling; multipart uploads are exempt from
# the HTTP deadline because the body streams for as long as the upload lasts.
REQUEST_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
# Extension packages (PLAN §38). Every direct child of this directory with a manifest.json is a
# package; only installed ones are loaded (GET/POST /api/v1/Extension). `modules` holds the three
# sample packages shipped with the repository. Install/enable/disable need a restart of the API
# *and* the worker to take effect.
EXTENSIONS_DIR=extensions
# Version extension manifests are checked against (min/maxPlatformVersion).
PLATFORM_VERSION=1.0.0
# 32-byte hex key (openssl rand -hex 32) for secrets stored encrypted at rest. Required by mail
# account credentials and by extensions that store their own secrets (e.g. webhook signing keys).
ENCRYPTION_KEY=
JOB_QUEUE_NAME=crm-jobs
JOB_ATTEMPTS=3
JOB_BACKOFF_BASE_MS=2000
# Required on both API and worker to enable worker-driven jobs: scheduled report delivery and
# AI Agent runs (CRM Chat). Without it those jobs are inert. Use a random secret with at least 32
# bytes; worker contacts the API at this URL.
REPORT_WORKER_SECRET=
REPORT_WORKER_API_URL=http://127.0.0.1:3030

# Outbound email (PLAN §28). none = never deliver; memory = keep messages in the process (tests);
# smtp = authenticating mailbox; relay = generic SMTP relay, must NOT carry credentials.
MAIL_TRANSPORT=none
SMTP_HOST=
SMTP_PORT=587
# Empty = derive (465 is implicit TLS, anything else upgrades with STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Sending mailbox; defaults to SMTP_USER. Messages from any other address are refused unless
# SMTP_STRICT_FROM=false.
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_REPLY_TO=
# Used for generated Message-Ids; defaults to the domain part of SMTP_FROM.
SMTP_MESSAGE_DOMAIN=
SMTP_POOL_SIZE=2
SMTP_MAX_MESSAGES=10
SMTP_CONNECTION_TIMEOUT_MS=20000
SMTP_GREETING_TIMEOUT_MS=20000
SMTP_SOCKET_TIMEOUT_MS=60000
SMTP_STRICT_FROM=true
# Ceiling over to+cc+bcc for one message.
MAIL_MAX_RECIPIENTS=50

# ---------------------------------------------------------------------------
# External identity — generic OpenID Connect sign-in (Phase 23.3, PLAN §17.3)
# ---------------------------------------------------------------------------
# A provider is CONFIGURATION, not code: one JSON array of profiles. Empty (the default) means the
# installation offers no external sign-in, which is the safe state. A malformed profile refuses the
# boot, so a typo is visible immediately rather than at the first sign-in attempt.
#
# Every endpoint must be https, must carry no credentials in the URL, and must not be a private or
# loopback address. The redirect URI to register at the provider is exactly:
#     /api/v1/Oidc/callback
# The platform compares the redirected value with the one it sent and refuses a mismatch before it
# exchanges the code.
#
# linkByEmail: may an external identity whose email the provider marks VERIFIED bind to an existing
#   local account? It binds only when exactly ONE account matches, so an address can never pick a
#   victim. An unverified email never binds.
# autoProvision: may an unknown external identity create a local account? It receives defaultRoleIds.
#
# Example:
# OIDC_PROFILES=[{"key":"google","displayName":"Google","issuer":"https://accounts.google.com","authorizationEndpoint":"https://accounts.google.com/o/oauth2/v2/auth","tokenEndpoint":"https://oauth2.googleapis.com/token","jwksUri":"https://www.googleapis.com/oauth2/v3/certs","clientId":"...","clientSecret":"...","scopes":["openid","email","profile"],"linkByEmail":true,"autoProvision":true,"defaultRoleIds":[]}]
OIDC_PROFILES=
# How long a sign-in attempt stays usable (60-3600 seconds).
OIDC_STATE_TTL_SECONDS=600
# Where the browser goes after a successful external sign-in. Relative path only — an absolute URL
# would be an open redirect.
OIDC_POST_LOGIN_REDIRECT=/
# Where the browser goes when an external sign-in is refused. Relative path only, for the same reason.
OIDC_LOGIN_PATH=/login
