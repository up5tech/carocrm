{
  "name": "carocrm",
  "version": "1.0.0",
  "description": "NestJS CRM Platform - Clean-room reimplementation of EspoCRM concepts",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.5",
      "fast-uri@>=3.0.0 <4.0.0": "3.1.9",
      "fast-uri@>=4.0.0 <5.0.0": "4.2.3"
    }
  },
  "scripts": {
    "lint": "node scripts/check-ui-conventions.mjs && eslint . --max-warnings=0 --cache",
    "lint:fix": "eslint . --fix --cache",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint:ui": "node scripts/check-ui-conventions.mjs",
    "lint:arch": "node scripts/check-architecture-boundaries.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run --config vitest.ci.config.ts",
    "test:worker": "pnpm --filter @carocrm/worker test",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r build",
    "dev": "pnpm -r --filter @carocrm/api dev",
    "dev:all": "concurrently \"pnpm -r --filter @carocrm/api dev\" \"pnpm -r --filter @carocrm/web dev\"",
    "db:migrate": "tsx database/migrate.ts",
    "db:seed": "tsx database/seed.ts",
    "demo:projects": "tsx scripts/projects-demo.ts",
    "demo:projects:purge": "tsx scripts/projects-demo.ts --purge",
    "test:e2e": "E2E_ALLOW_PRIMARY_DB=1 bash scripts/e2e-smoke.sh",
    "ci:secrets": "node scripts/check-secrets.mjs",
    "ci:migrations": "node scripts/check-migrations.mjs",
    "backup": "node scripts/backup.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "ci:gate": "pnpm lint && pnpm lint:arch && pnpm typecheck && pnpm build && pnpm ci:migrations && pnpm test:ci && pnpm test:worker && pnpm test:web && pnpm ci:secrets",
    "verify": "concurrently -n lint,typecheck,test,test:web -c cyan,magenta,yellow,green \"pnpm lint\" \"pnpm typecheck\" \"pnpm test\" \"pnpm test:web\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "argon2": "^0.40.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.15.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^3.2.0",
    "globals": "^16.0.0",
    "pg": "^8.13.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.0.0"
  },
  "type": "module"
}
